APP_NAME=Keystead
APP_ENV=local
APP_KEY=base64:r2CP4zdSI81NzusdbEBXY3HmUOTBKcXkqGLyeUWVR6U=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8 / MariaDB 10.6+ recommended (row locking is exercised). SQLite works for the test-suite.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/testing.sqlite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# API tokens expire after this many minutes (default 7 days)
SANCTUM_TOKEN_TTL_MINUTES=10080

# E-mail. The log driver writes messages to storage/logs/laravel.log (fine for local work).
# For real delivery set MAIL_MAILER=smtp plus MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD.
# All notification e-mails (financial and security) are sent immediately after the database commit; no queue worker is needed.
# A mail failure is reported to the log but never fails the money operation.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@keystead.test"
MAIL_FROM_NAME="${APP_NAME}"

# Demo data (php artisan db:seed) is refused when APP_ENV=production.
# These only apply to the seeded demo accounts.
DEMO_PASSWORD=Password123!

# Account security (all optional; defaults shown)
KEYSTEAD_REGISTRATION_TOKEN_TTL=1440  # minutes
KEYSTEAD_PASSWORD_RESET_TOKEN_TTL=60  # minutes
KEYSTEAD_TOKEN_RESEND_COOLDOWN=60  # seconds
# Money endpoints refuse unverified accounts when true
KEYSTEAD_REQUIRE_VERIFIED_EMAIL=true
# Links placed in e-mails; point these at your front-end if you have one. {token} and {email} are substituted.
# KEYSTEAD_VERIFY_URL=/verify-email/{token}?email={email}
# KEYSTEAD_RESET_URL=/reset-password/{token}?email={email}
# Idempotency-Key replay window (hours)
KEYSTEAD_IDEMPOTENCY_TTL_HOURS=24
