                "v1",
                "withdrawals"
              ]
            }
          }
        },
        {
          "name": "Request withdrawal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/withdrawals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "withdrawals"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"100.00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Investments",
      "item": [
        {
          "name": "Open projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/investment-projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "investment-projects"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json(); if(j.data&&j.data[0]) pm.collectionVariables.set('projectId', j.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Invest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/investments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "investments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"investment_project_id\": \"{{projectId}}\",\n  \"amount\": \"2500.00\"\n}"
            }
          }
        },
        {
          "name": "My investments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/investments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "investments"
              ]
            }
          }
        },
        {
          "name": "Summary",
